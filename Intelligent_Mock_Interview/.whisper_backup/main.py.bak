ROOT_DIR = os.path.dirname(BASE_DIR)

def _get_gemini_api_key() -> str:
    # Check existing environment
    key = os.getenv("GEMINI_API_KEY", "").strip() or os.getenv("GOOGLE_API_KEY", "").strip()
    if key:
        os.environ["GEMINI_API_KEY"] = key
        return key

    # Check absolute paths to root .env and project .env
    env_paths = [
        os.path.join(ROOT_DIR, ".env"),
        os.path.join(BASE_DIR, ".env"),
        os.path.join(os.path.abspath("."), ".env"),
    ]
    for p in env_paths:
        if os.path.exists(p):
            # Honor an explicitly configured process environment; only fill values
            # that are absent from it using the project-root .env file.
            load_dotenv(p, override=False)
            key = os.getenv("GEMINI_API_KEY", "").strip() or os.getenv("GOOGLE_API_KEY", "").strip()
            if key:
                os.environ["GEMINI_API_KEY"] = key
                return key
    return ""

_get_gemini_api_key()
